# Server Port
PORT=3000

# Optional override for Admin Portal secret password
ADMIN_ACCESS_PASSWORD=

# Option A: Africa's Talking SMS Gateway (Recommended for Kenya +254)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Set to "sandbox" for Africa's Talking sandbox or "production" for live dispatch
AT_ENV=production

# Option B: Twilio Programmable SMS Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
